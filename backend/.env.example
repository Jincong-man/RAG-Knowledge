# ==================== 大模型配置 ====================
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
QWEN_MODEL=qwen3.8-flash
QWEN_API_BASE=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
# 关闭思考模式可显著降低首字延迟（需要深度推理时改为 true）
QWEN_ENABLE_THINKING=false

# ==================== Embedding & Reranker ====================
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ==================== 数据库 ====================
DATABASE_URL=sqlite+aiosqlite:///./app.db

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0

# ==================== JWT认证 ====================
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 存储 ====================
CHROMA_PERSIST_DIR=./chroma_data
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ==================== RAG参数 ====================
CHUNK_SIZE=400
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5

# ==================== 缓存 ====================
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_SECONDS=3600

# ==================== 频率限制 ====================
RATE_LIMIT_PER_MINUTE=30

# ==================== 部署 / 演示 ====================
ADMIN_USERNAME=jincong
ADMIN_PASSWORD=123456
# 知识库为空时自动导入 demo_data 里的示例文档（公开演示站建议 true）
SEED_DEMO_DATA=false
# 与 Cloudflare Pages 的 PROXY_SECRET 保持一致，用于识别真实用户IP
PROXY_SECRET=
